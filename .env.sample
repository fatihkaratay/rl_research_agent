# Database Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=rl_research_db

# AI Model Configuration (Add your keys here)
OPENAI_API_KEY=...
GOOGLE_API_KEY=AIza...

# Agent Settings
MAX_RESEARCH_RESULTS=5

# search settings
HUGGINGFACE_URL=https://huggingface.co/api/daily_papers
MAX_RESEARCH_RESULTS=5
RESEARCH_TOPICS="reinforcement learning, rl, ppo, dpo, q-learning, imitation learning"

# Author Watchlist
TARGET_AUTHORS="Abhishek Cauligi, Behcet Acikmese"
DISCOVERY_AUTHOR="Abhishek Cauligi"
MAX_NODES = 20

# Summary language for AI analysis (e.g., Turkish, English, Spanish)
SUMMARY_LANGUAGE=Turkish

# Auto-expire papers older than this many days (TTL index). Set to 0 to disable.
PAPER_TTL_DAYS=365

# Feature 1: Email + Slack Digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO_EMAIL=
SLACK_WEBHOOK_URL=

# Feature 4: ArXiv categories (comma-separated)
ARXIV_CATEGORIES=cs.LG,cs.AI,cs.RO

# Feature 14: Scheduler cron (default: 8am UTC daily)
SCHEDULE_CRON=0 8 * * *